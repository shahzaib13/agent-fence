# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files stay local — never commit a webhook URL or key
.env
.env.*
# ...but the template has to reach the repo, or nobody knows the key is needed at all.
!.env.example
# ...and the functions one holds only allowed origins, which belong in the repo.
!functions/.env


# Working notes, not part of the app. No leading "./" — git does not support that prefix, and
# the two patterns that used to have it silently matched nothing, so both files ended up
# committed anyway.
WORKFLOW_INTEGRATION.md
UI_REFERNCE_FIGMA.txt
SECURITY_AUDIT.md
SECURITY_TODOS.md
N8N_TODOS.md

