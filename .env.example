# Copy to .env and fill in. Real values are gitignored, so anything deployed (Vercel,
# Netlify, CI) needs these set in that platform's own environment settings — a missing
# VITE_GOOGLE_MAPS_API_KEY does not fail the build, it just silently removes the suburb picker.

# n8n webhook the frontend posts to. The production URL is already the built-in default in
# src/services/fencingChat.ts, so this only matters when pointing somewhere else.
VITE_FENCING_CHAT_WEBHOOK_URL=

# Google Maps JS SDK — powers the suburb picker. Needs "Maps JavaScript API" and "Places API"
# (the legacy one) enabled on the Cloud project, and an HTTP-referrer restriction that lists
# every domain the app runs on, including *.vercel.app previews.
VITE_GOOGLE_MAPS_API_KEY=

# Where a verified customer is sent once their job is posted. The app appends `#t=<customToken>`
# after OTP — QuoteMy reads that hash and signs them in. Do not put a token in this value.
VITE_PARTNER_SITE_URL=https://quotemy-ai.web.app/app

# createHandoff Cloud Function (see functions/) — mints a Firebase Admin custom token for the
# signed-in uid. Required for signed-in handoff; the production URL is also the built-in default.
# After changing this on Vercel/Netlify, rebuild — Vite bakes VITE_* at build time.
VITE_HANDOFF_URL=https://us-central1-quotemy-ai.cloudfunctions.net/createHandoff

# Which country a locally-typed phone number belongs to: 0302… becomes <this>302…. The built-in
# fallback is +92 (where testing happens); set +61 for the Australian launch. Format must be a +
# followed by 1–3 digits — anything else is ignored so a typo can't silently break every OTP.
VITE_DEFAULT_COUNTRY_CODE=+92

# ⚠️ Reminder for anything added below this line: every VITE_* variable is compiled into the
# public JavaScript bundle and is readable by anyone who opens DevTools. Gitignoring this file
# protects GitHub, not the browser. A value belongs here only if it is safe to publish. Real
# secrets go server-side — the Cloud Function, n8n credentials, or Firebase security rules.
